<Window x:Class="AiMeetingAssistant.Desktop.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Settings · AI Meeting Assistant" Width="720" Height="610" MinWidth="620" Background="{StaticResource CanvasBrush}" WindowStartupLocation="CenterOwner"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28"><TextBlock Text="SETTINGS" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text="Application settings" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,20"/>
<Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Recording" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="ScreenCaptureCheckBox" Content="Capture screen by default" Foreground="{StaticResource TextBrush}" Margin="0,12,0,0"/></StackPanel></Border>
<Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Storage" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Session library directory" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,5"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CaptureDirectoryTextBox" Padding="8"/><Button Grid.Column="1" Content="Browse" Click="OnBrowseCapture" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/></Grid></StackPanel></Border>
<Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="AI model" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Local model directory (blank = automatic development model)" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,5"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ModelDirectoryTextBox" Padding="8"/><Button Grid.Column="1" Content="Browse" Click="OnBrowseModel" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/></Grid><TextBlock Text="Compute preference" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,5"/><ComboBox x:Name="ComputeComboBox" SelectedValuePath="Value"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Foreground="#111827"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel></Border>
<Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Diagnostics" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="SettingsPathText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border><TextBlock x:Name="ResultText" Foreground="{StaticResource RecordBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Save settings" Click="OnSave" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel></StackPanel></ScrollViewer></Window>

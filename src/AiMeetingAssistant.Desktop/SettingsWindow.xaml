<Window x:Class="AiMeetingAssistant.Desktop.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Settings · AI Meeting Assistant" Width="760" Height="720" MinWidth="640" Background="{StaticResource CanvasBrush}" WindowStartupLocation="CenterOwner"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
<TextBlock Text="SETTINGS" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text="Application settings" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,20"/>
<Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Recording" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="ScreenCaptureCheckBox" Content="Capture screen by default" Foreground="{StaticResource TextBrush}" Margin="0,12,0,0"/><TextBlock Text="System audio recording level" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,3"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><Slider x:Name="SystemAudioGainSlider" Minimum="0.25" Maximum="1.5" TickFrequency="0.05" IsSnapToTickEnabled="True"/><TextBlock Grid.Column="1" Text="{Binding ElementName=SystemAudioGainSlider, Path=Value, StringFormat={}{0:P0}}" HorizontalAlignment="Right"/></Grid><TextBlock Text="Microphone recording level" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,3"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><Slider x:Name="MicrophoneGainSlider" Minimum="0.25" Maximum="1.5" TickFrequency="0.05" IsSnapToTickEnabled="True"/><TextBlock Grid.Column="1" Text="{Binding ElementName=MicrophoneGainSlider, Path=Value, StringFormat={}{0:P0}}" HorizontalAlignment="Right"/></Grid><TextBlock Text="100% preserves the captured level. Digital clipping protection prevents numeric overflow; already-clipped hardware input cannot be restored." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border>
<Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Storage" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Session library directory" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,5"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CaptureDirectoryTextBox" Padding="8"/><Button Grid.Column="1" Content="Browse" Click="OnBrowseCapture" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/></Grid></StackPanel></Border>
<Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Speech model" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Default model for new transcription jobs" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,5"/>
<ComboBox x:Name="SpeechModelComboBox" SelectedValuePath="Id" SelectionChanged="OnSpeechModelChanged"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding DisplayName}" Foreground="#111827"/><TextBlock Text="{Binding InstallLabel}" Foreground="#4B5563" Margin="8,0,0,0"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
<Border Background="{StaticResource RaisedBrush}" CornerRadius="8" Padding="12" Margin="0,10,0,0"><StackPanel><TextBlock x:Name="SpeechModelStatusText" FontWeight="SemiBold"/><TextBlock x:Name="SpeechModelDetailText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/><ProgressBar x:Name="SpeechModelProgress" Height="7" Margin="0,10,0,0" Visibility="Collapsed"/><TextBlock x:Name="SpeechModelOperationText" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="InstallSpeechModelButton" Content="Install selected" Click="OnInstallSpeechModel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button x:Name="RemoveSpeechModelButton" Content="Remove selected" Click="OnRemoveSpeechModel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button x:Name="CancelSpeechModelButton" Content="Cancel download" Click="OnCancelSpeechModel" Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed"/></StackPanel></StackPanel></Border>
<Expander Header="Advanced: custom model directory" Foreground="{StaticResource TextBrush}" Margin="0,12,0,0"><StackPanel Margin="0,8,0,0"><TextBlock Text="A custom directory overrides the catalog selection." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ModelDirectoryTextBox" Padding="8"/><Button Grid.Column="1" Content="Browse" Click="OnBrowseModel" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/></Grid></StackPanel></Expander>
<TextBlock Text="Compute preference" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,5"/><ComboBox x:Name="ComputeComboBox" SelectedValuePath="Value"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Foreground="#111827"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
<Border Background="{StaticResource RaisedBrush}" CornerRadius="8" Padding="12" Margin="0,8,0,0"><StackPanel><TextBlock Text="Intel acceleration" FontWeight="SemiBold"/><TextBlock x:Name="IntelStatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
<Separator Margin="0,16,0,12" Background="#3B4B60"/><TextBlock Text="Speaker diarization model" FontWeight="SemiBold"/><TextBlock Text="Enter a Hugging Face read token once. It is used only by the download process and is not saved." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><PasswordBox x:Name="HuggingFaceTokenBox" Padding="8"/><Button x:Name="InstallDiarizationButton" Grid.Column="1" Content="Install model" Click="OnInstallDiarization" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/></Grid><TextBlock x:Name="DiarizationInstallStatus" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
<Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Diagnostics" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="SettingsPathText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border><TextBlock x:Name="ResultText" Foreground="{StaticResource RecordBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Save settings" Click="OnSave" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel>
</StackPanel></ScrollViewer></Window>

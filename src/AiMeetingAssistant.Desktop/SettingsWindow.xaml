<Window x:Class="AiMeetingAssistant.Desktop.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Settings · AI Meeting Assistant" Icon="Assets/assistant-avatar.png" Width="900" Height="760" MinWidth="720" MinHeight="600" Background="{StaticResource CanvasBrush}" WindowStartupLocation="CenterOwner"><Grid><Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="70"/></Grid.RowDefinitions><Border Background="#101722" BorderBrush="#243042" BorderThickness="0,0,0,1"><Grid Margin="30,0"><StackPanel VerticalAlignment="Center"><TextBlock Text="SETTINGS" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Configure your meeting workspace" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><TextBlock Text="General · Models · Diagnostics" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border><TabControl Grid.Row="1" Margin="30,18,22,12" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SettingsTabItemStyle}"><TabItem Header="General"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,18,8,0">
<Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Recording defaults" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Audio source levels are adjusted directly beside the live meters in Capture." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/><WrapPanel Margin="0,16,0,2"><CheckBox x:Name="ScreenCaptureCheckBox" Content="Screen capture" Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,28,0"/><CheckBox x:Name="LiveTranscriptionCheckBox" Content="Live transcription" Style="{StaticResource ToggleSwitchStyle}"/></WrapPanel><Separator Margin="0,14,0,12" Background="#3B4B60"/><CheckBox x:Name="AutomaticFlacCheckBox" Content="Automatically create verified FLAC archives" Style="{StaticResource ToggleSwitchStyle}" Loaded="OnStorageAutomationLoaded"/><CheckBox x:Name="AutomaticWavRemovalCheckBox" Content="Automatically remove WAV after proven FLAC transcription" Style="{StaticResource ToggleSwitchStyle}" Margin="0,12,0,0"/><TextBlock Text="Automatic WAV removal remains evidence-gated and is disabled by default." Foreground="#E5B567" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Border>
<Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Storage" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Session library directory" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,5"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CaptureDirectoryTextBox" Padding="8"/><Button Grid.Column="1" Content="Browse" Click="OnBrowseCapture" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/></Grid><TextBlock Text="Changing the library location requires an application restart. Existing meetings are not moved automatically." Foreground="#E5B567" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem><TabItem Header="Models"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,18,8,0">
<Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Speech model" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Default model for new transcription jobs" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,5"/>
<ComboBox x:Name="SpeechModelComboBox" SelectedValuePath="Id" SelectionChanged="OnSpeechModelChanged"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextBrush}"/><TextBlock Text="{Binding InstallLabel}" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
<Border Background="{StaticResource RaisedBrush}" CornerRadius="8" Padding="12" Margin="0,10,0,0"><StackPanel><TextBlock x:Name="SpeechModelStatusText" FontWeight="SemiBold"/><TextBlock x:Name="SpeechModelDetailText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/><ProgressBar x:Name="SpeechModelProgress" Height="7" Margin="0,10,0,0" Visibility="Collapsed"/><TextBlock x:Name="SpeechModelOperationText" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="InstallSpeechModelButton" Content="Install selected" Click="OnInstallSpeechModel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button x:Name="RemoveSpeechModelButton" Content="Remove selected" Click="OnRemoveSpeechModel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button x:Name="CancelSpeechModelButton" Content="Cancel download" Click="OnCancelSpeechModel" Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed"/></StackPanel></StackPanel></Border>
<Expander Header="Advanced: custom model directory" Foreground="{StaticResource TextBrush}" Margin="0,12,0,0"><StackPanel Margin="0,8,0,0"><TextBlock Text="A custom directory overrides the catalog selection." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ModelDirectoryTextBox" Padding="8"/><Button Grid.Column="1" Content="Browse" Click="OnBrowseModel" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/></Grid></StackPanel></Expander>
<TextBlock Text="Compute preference" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,5"/><ComboBox x:Name="ComputeComboBox" SelectedValuePath="Value"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Foreground="{StaticResource TextBrush}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
<Border Background="{StaticResource RaisedBrush}" CornerRadius="8" Padding="12" Margin="0,8,0,0"><StackPanel><TextBlock Text="Intel acceleration" FontWeight="SemiBold"/><TextBlock x:Name="IntelStatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
<Separator Margin="0,16,0,12" Background="#3B4B60"/><TextBlock Text="Speaker diarization model" FontWeight="SemiBold"/><TextBlock Text="Enter a Hugging Face read token once. It is used only by the download process and is not saved." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><PasswordBox x:Name="HuggingFaceTokenBox" Padding="8"/><Button x:Name="InstallDiarizationButton" Grid.Column="1" Content="Install model" Click="OnInstallDiarization" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/></Grid><TextBlock x:Name="DiarizationInstallStatus" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem><TabItem Header="Diagnostics"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,18,8,0">
<Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Diagnostics" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Local configuration" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/><TextBlock x:Name="SettingsPathText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/><TextBlock Text="Worker and processing events are available under Technical activity in the Capture workspace." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
</StackPanel></ScrollViewer></TabItem></TabControl><Border Grid.Row="2" Background="#101722" BorderBrush="#243042" BorderThickness="0,1,0,0"><Grid Margin="30,0"><TextBlock x:Name="ResultText" Foreground="{StaticResource RecordBrush}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="590"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Save settings" Click="OnSave" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel></Grid></Border></Grid></Window>

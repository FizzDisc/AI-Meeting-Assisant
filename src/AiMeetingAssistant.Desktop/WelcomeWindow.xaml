<Window x:Class="AiMeetingAssistant.Desktop.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome · AI Meeting Assistant" Width="850" Height="750" MinWidth="720" MinHeight="640"
        Background="{StaticResource CanvasBrush}" Icon="Assets/assistant.ico" WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="AI MEETING ASSISTANT" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="12"/>
            <TextBlock x:Name="Heading" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,10"/>
            <TextBlock x:Name="StepLabel" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="Pages">
                <StackPanel x:Name="WelcomePage">
                    <Border Style="{StaticResource CardStyle}"><StackPanel>
                        <TextBlock Text="Your meetings, on your computer." FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="Choose where recordings live, prepare local transcription and pick a speech model. You can also start with recording only." TextWrapping="Wrap" FontSize="15" Margin="0,14,0,0"/>
                        <TextBlock Text="01   Choose your recording folder&#x0a;&#x0a;02   Set up optional AI components&#x0a;&#x0a;03   Check your setup and start" FontSize="16" Margin="0,26,0,0"/>
                    </StackPanel></Border>
                    <TextBlock Text="Recording and transcription run locally. Setup downloads Python and AI libraries from their public sources and models only when you choose to install them. Audio is not uploaded by this setup." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="4,20,4,0"/>
                </StackPanel>
                <StackPanel x:Name="StoragePage" Visibility="Collapsed">
                    <Border Style="{StaticResource CardStyle}"><StackPanel>
                        <TextBlock Text="Where should your meetings be saved?" FontSize="20" TextWrapping="Wrap"/>
                        <TextBlock Text="Choose a writable folder with enough free space. Existing meetings will not be moved." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,16"/>
                        <DockPanel><Button DockPanel.Dock="Right" Content="Browse" Click="BrowseStorage" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"/><TextBox x:Name="RecordingFolder"/></DockPanel>
                        <CheckBox x:Name="ScreenCapture" Content="Include screen recording by default" Style="{StaticResource ToggleSwitchStyle}" Margin="0,24,0,0"/>
                        <TextBlock Text="Microphone and system audio sources can be selected in the recording workspace before each meeting." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,20,0,0"/>
                    </StackPanel></Border>
                </StackPanel>
                <StackPanel x:Name="AiPage" Visibility="Collapsed">
                    <Border Style="{StaticResource CardStyle}"><StackPanel>
                        <TextBlock Text="1. Prepare local AI" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="One click downloads and prepares everything needed for local transcription. No separate Python installation is needed. Speech models are downloaded in the next step." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12"/>
                        <TextBlock x:Name="RuntimeDetails" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
                        <Button x:Name="RuntimeDownloadButton" Content="Download AI components" Click="InstallRuntime" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock x:Name="RuntimeStatus" Text="AI components have not been installed yet." TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"><StackPanel>
                        <TextBlock Text="2. Choose your speech model" FontSize="19" FontWeight="SemiBold"/>
                        <ComboBox x:Name="Models" SelectedValuePath="Id" SelectionChanged="ModelChanged" Margin="0,12,0,0"/>
                        <TextBlock x:Name="ModelDetails" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,10"/>
                        <Button Content="Download selected model" Click="InstallModel" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="ModelStatus" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0"/>
                        <TextBlock Text="Processing" Margin="0,16,0,6"/>
                        <ComboBox x:Name="Compute" SelectedValuePath="Value">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Intel GPU setup and optional speaker identification are available in Settings. Speaker identification requires accepting the model terms on Hugging Face." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
                    </StackPanel></Border>
                </StackPanel>
                <StackPanel x:Name="FinishPage" Visibility="Collapsed">
                    <Border Style="{StaticResource CardStyle}"><StackPanel>
                        <TextBlock Text="Your workspace is ready" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="Summary" TextWrapping="Wrap" FontSize="15" Margin="0,18,0,0"/>
                        <TextBlock Text="Before your first meeting, select the system audio output and check the live audio meters. Enable microphone capture if you also want to record your voice." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,22,0,0"/>
                        <TextBlock Text="You can change models and recording options later in Settings. You can also schedule this assistant to run again on the next launch." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0"/>
                    </StackPanel></Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,14,0,14">
            <ProgressBar x:Name="BusyProgress" Height="5" IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBlock x:Name="Status" TextWrapping="Wrap" MaxHeight="80" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0"/>
            <Button x:Name="CancelOperation" Content="Cancel operation" Click="CancelSetup" Visibility="Collapsed" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
        </StackPanel>
        <DockPanel Grid.Row="3">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="Export diagnosis" Click="OnExportDiagnosis" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                <Button x:Name="LaterButton" Content="Set up later" Click="Later" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                <Button x:Name="RecordingOnlyButton" Content="Recording only" Click="RecordingOnly" Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="Back" Click="Back" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0"/>
                <Button x:Name="NextButton" Content="Next" Click="Next" Style="{StaticResource SecondaryButtonStyle}" MinWidth="100"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

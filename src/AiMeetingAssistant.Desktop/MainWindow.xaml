<Window x:Class="AiMeetingAssistant.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Meeting Assistant" Width="1180" Height="760" MinWidth="920" MinHeight="620"
        Background="{StaticResource CanvasBrush}" WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="26"/><RowDefinition Height="*"/>
            <RowDefinition Height="20"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="AI MEETING ASSISTANT" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StateLabel}" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,0"/>
                <TextBlock Text="Capture, transcribe and turn conversations into clear outcomes." Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,8,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Button Content="Settings" Click="OnOpenSettings" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/><Border Background="#18352E" CornerRadius="12" Padding="14,8"><TextBlock Text="SPRINT 3.4.1 · MODEL CATALOG" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/></Border></StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="0.75*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="New recording" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SourceSummary}" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/>
                        </StackPanel>
                        <Button Content="Refresh devices" Command="{Binding RefreshSourcesCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <Button Width="126" Height="126" Command="{Binding ToggleRecordingCommand}" ToolTip="Start or stop screen, system audio and microphone recording" HorizontalAlignment="Center" BorderThickness="0" Background="Transparent">
                            <Grid>
                                <Ellipse Fill="#3A2327"/>
                                <Ellipse Width="72" Height="72" Fill="{StaticResource RecordBrush}"/>
                                <Ellipse Width="26" Height="26" Fill="White" Opacity="0.9">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding IsRecording}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Rectangle Width="24" Height="24" RadiusX="4" RadiusY="4" Fill="White" Opacity="0.9">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding IsRecording}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                            </Grid>
                        </Button>
                        <TextBlock Text="{Binding RecordingButtonLabel}" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0"/>
                        <TextBlock Text="{Binding RecordingElapsedLabel}" HorizontalAlignment="Center" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="SYSTEM AUDIO" Foreground="{StaticResource MutedBrush}" FontSize="10"/><ProgressBar Height="7" Margin="0,5,0,0" Maximum="100" Value="{Binding SystemAudioLevel, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" Background="#1A3A35"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="MICROPHONE" Foreground="{StaticResource MutedBrush}" FontSize="10"/><ProgressBar Height="7" Margin="0,5,0,0" Maximum="100" Value="{Binding MicrophoneLevel, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" Background="#1A3A35"/></StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding ErrorMessage}" HorizontalAlignment="Center" Foreground="{StaticResource RecordBrush}" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="620"/>
                    </StackPanel>
                    <UniformGrid Grid.Row="2" Columns="3">
                        <Border Background="{StaticResource RaisedBrush}" CornerRadius="10" Padding="14" Margin="0,0,8,0"><StackPanel><Grid><TextBlock Text="SCREEN" Foreground="{StaticResource MutedBrush}" FontSize="11"/><CheckBox Content="Capture" IsChecked="{Binding IsScreenCaptureEnabled}" IsEnabled="{Binding CanChangeSources}" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right"/></Grid><ComboBox ItemsSource="{Binding ScreenSources}" SelectedItem="{Binding SelectedScreen}" IsEnabled="{Binding ScreenSelectionEnabled}" Margin="0,8,0,0"/></StackPanel></Border>
                        <Border Background="{StaticResource RaisedBrush}" CornerRadius="10" Padding="14" Margin="4,0"><StackPanel><TextBlock Text="SYSTEM / TEAMS AUDIO" Foreground="{StaticResource MutedBrush}" FontSize="11"/><ComboBox ItemsSource="{Binding SystemAudioSources}" SelectedItem="{Binding SelectedSystemAudio}" IsEnabled="{Binding CanChangeSources}" Margin="0,8,0,0"/></StackPanel></Border>
                        <Border Background="{StaticResource RaisedBrush}" CornerRadius="10" Padding="14" Margin="8,0,0,0"><StackPanel><TextBlock Text="MICROPHONE" Foreground="{StaticResource MutedBrush}" FontSize="11"/><ComboBox ItemsSource="{Binding MicrophoneSources}" SelectedItem="{Binding SelectedMicrophone}" IsEnabled="{Binding CanChangeSources}" Margin="0,8,0,0"/></StackPanel></Border>
                    </UniformGrid>
                </Grid>
            </Border>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Status center" FontSize="18" FontWeight="SemiBold"/>
                            <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding OperationalStatusMessage}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding RuntimeStatus}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,7,0,0"/>
                        <Expander Header="Technical activity" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding StatusLogEntries}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeLabel}" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Clear activity" Command="{Binding ClearStatusLogCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Local transcription" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TranscriptionStatusMessage}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                        <TextBlock Text="{Binding TranscriptionActivityDetail}" Foreground="{StaticResource AccentBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <ProgressBar Height="7" Minimum="0" Maximum="100" Value="{Binding TranscriptionProgress, Mode=OneWay}" IsIndeterminate="{Binding IsTranscriptionIndeterminate}" Foreground="{StaticResource AccentBrush}" Background="#1A3A35" Margin="0,12,0,0"/>
                        <UniformGrid Columns="3" Margin="0,12,0,0">
                            <Button Content="Transcribe latest" Command="{Binding TranscribeLatestCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,5,0"/>
                            <Button Content="Cancel" Command="{Binding CancelTranscriptionCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="5,0"/>
                            <Button Content="Open transcript" Click="OnOpenTranscript" IsEnabled="{Binding HasTranscript}" Style="{StaticResource SecondaryButtonStyle}" Margin="5,0,0,0"/>
                        </UniformGrid>
                        <TextBlock Text="{Binding TranscriptPath}" Foreground="{StaticResource AccentBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Meeting library" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding MeetingLibraryStatus}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                        <Button Content="Open recordings" Click="OnOpenMeetingLibrary" Style="{StaticResource SecondaryButtonStyle}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid Grid.Row="4"><TextBlock Text="Local capture, transcription and speaker analysis" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock Text="Sprint 3.4.1 · Local model selection" Foreground="{StaticResource AccentBrush}" FontSize="12" HorizontalAlignment="Right"/></Grid>
    </Grid>
</Window>

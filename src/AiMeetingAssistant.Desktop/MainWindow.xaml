<Window x:Class="AiMeetingAssistant.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Meeting Assistant" Icon="Assets/assistant-avatar.png" Width="1280" Height="760" MinWidth="960" MinHeight="640"
        Background="{StaticResource CanvasBrush}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
        <Border Background="#101722" BorderBrush="#243042" BorderThickness="0,0,0,1">
            <Grid Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="AI MEETING ASSISTANT" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Meeting workspace" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="CaptureTabButton" Content="Capture" Click="OnNavigateCapture" Tag="Active" Style="{StaticResource NavigationButtonStyle}" Margin="0,0,8,0"/><Button x:Name="RecordingsTabButton" Content="Recordings" Click="OnNavigateRecordings" Style="{StaticResource NavigationButtonStyle}" Margin="0,0,8,0"/><Button x:Name="TranscriptTabButton" Content="Latest transcript" Click="OnNavigateTranscript" Style="{StaticResource NavigationButtonStyle}"/><Button x:Name="StorageTabButton" Content="Storage" Click="OnNavigateStorage" Style="{StaticResource NavigationButtonStyle}" Margin="8,0,0,0"/></StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Settings" Click="OnOpenSettings" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="CaptureWorkspace" Grid.Row="1" Margin="28,24,28,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="650"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*" MinWidth="310"/></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <ScrollViewer.Resources><Style TargetType="ScrollBar"><Setter Property="Width" Value="7"/><Setter Property="Opacity" Value="0.5"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent" Margin="1,0"><Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Background="#60758E"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.9"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ScrollViewer.Resources>
                <StackPanel>
                    <Grid Margin="2,0,2,16"><StackPanel><TextBlock Text="{Binding StateLabel}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Capture the meeting now; process and review it when you are ready." Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,5,0,0"/></StackPanel><Button Content="Refresh devices" Command="{Binding RefreshSourcesCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid><StackPanel><TextBlock Text="New recording" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding SourceSummary}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right"><CheckBox Content="Live transcription" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding LiveTranscriptionEnabled}" IsEnabled="{Binding CanChangeSources}" HorizontalAlignment="Right" ToolTip="Process audio during capture and finalize the transcript automatically"/><TextBlock Text="SESSION TIMER" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Right" Margin="0,7,0,0"/><TextBlock Text="{Binding RecordingElapsedLabel}" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,3,0,0"/></StackPanel></Grid>
                            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="156"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Command="{Binding ToggleRecordingCommand}" ToolTip="Start or stop recording" BorderThickness="0" Background="Transparent" Padding="0"><Border Style="{StaticResource RecordActionCardStyle}" CornerRadius="14" Padding="18"><StackPanel><Grid Width="74" Height="74" HorizontalAlignment="Center"><Ellipse Fill="#3A2327"/><Ellipse Width="48" Height="48" Fill="{StaticResource RecordBrush}"/><Ellipse Width="17" Height="17" Fill="White"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsRecording}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><Rectangle Width="24" Height="24" RadiusX="4" RadiusY="4" Fill="White"><Rectangle.Style><Style TargetType="Rectangle"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsRecording}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Rectangle.Style></Rectangle></Grid><TextBlock Text="{Binding RecordingButtonLabel}" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,10,0,0"/></StackPanel></Border></Button>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="SYSTEM AUDIO" Foreground="{StaticResource MutedBrush}" FontSize="10"/><ProgressBar Height="9" Margin="0,6,0,4" Maximum="100" Value="{Binding SystemAudioLevel, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" Background="#1A3A35"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><Slider Minimum="0.25" Maximum="1.5" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding SystemAudioGain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="1" Text="{Binding SystemAudioGain, StringFormat={}{0:P0}}" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Right"/></Grid><TextBlock Text="MICROPHONE" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,8,0,0"/><ProgressBar Height="9" Margin="0,6,0,4" Maximum="100" Value="{Binding MicrophoneLevel, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" Background="#1A3A35"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><Slider Minimum="0.25" Maximum="1.5" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding MicrophoneGain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Grid.Column="1" Text="{Binding MicrophoneGain, StringFormat={}{0:P0}}" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Right"/></Grid><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding AudioHealthMessage}" Foreground="#FBBF24" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding TeamsMuteStatusMessage}" Foreground="#E5B567" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource RecordBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
                            </Grid>
                            <UniformGrid Grid.Row="4" Columns="3"><Border Style="{StaticResource SourceCardStyle}" Margin="0,0,7,0"><StackPanel><Grid Height="24"><TextBlock Text="SCREEN" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/><CheckBox Content="Capture" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding IsScreenCaptureEnabled}" IsEnabled="{Binding CanChangeSources}" HorizontalAlignment="Right"/></Grid><ComboBox ItemsSource="{Binding ScreenSources}" SelectedItem="{Binding SelectedScreen}" IsEnabled="{Binding ScreenSelectionEnabled}" Margin="0,8,0,0" ToolTip="Select the display to capture"/></StackPanel></Border><Border Style="{StaticResource SourceCardStyle}" Margin="7,0"><StackPanel><Grid Height="24"><TextBlock Text="SYSTEM / TEAMS AUDIO" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/></Grid><ComboBox ItemsSource="{Binding SystemAudioSources}" SelectedItem="{Binding SelectedSystemAudio}" IsEnabled="{Binding CanChangeSources}" Margin="0,8,0,0" ToolTip="Select the system audio output"/></StackPanel></Border><Border Style="{StaticResource SourceCardStyle}" Margin="7,0,0,0"><StackPanel><Grid Height="24"><TextBlock Text="MICROPHONE" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/></Grid><ComboBox ItemsSource="{Binding MicrophoneSources}" SelectedItem="{Binding SelectedMicrophone}" IsEnabled="{Binding MicrophoneSelectionEnabled}" Margin="0,8,0,0" ToolTip="Select the microphone input"/></StackPanel></Border></UniformGrid>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="2" Background="#121A25" BorderBrush="#2A3748" BorderThickness="1" CornerRadius="18">
                <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><Grid><StackPanel Margin="0,0,96,0"><TextBlock Text="MEETING ASSISTANT" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/><TextBlock Text="Here when you need context" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="165" Margin="0,4,0,0"/></StackPanel><Ellipse Width="84" Height="84" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" HorizontalAlignment="Right"><Ellipse.Fill><ImageBrush ImageSource="Assets/assistant-avatar.png" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse></Grid><TextBlock Text="Status, guidance and meeting questions appear here." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/><Button Content="How it works" Click="OnOpenHelp" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel>
                    <Border Grid.Row="2" Background="#192330" CornerRadius="12" Padding="15"><StackPanel><Grid><TextBlock Text="Current status" FontWeight="SemiBold"/><Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><TextBlock Text="{Binding OperationalStatusMessage}" TextWrapping="Wrap" Margin="0,9,0,0"/><TextBlock Text="{Binding RuntimeStatus}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"/></StackPanel></Border>
                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="Meeting context" FontWeight="SemiBold" Margin="0,0,0,8"/><Border Background="#192330" CornerRadius="10" Padding="13" Margin="0,0,0,14"><StackPanel><TextBlock Text="CAPTURE SOURCES" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock Text="{Binding SourceSummary}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,9"/><TextBlock Text="RECORDINGS" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock Text="{Binding MeetingLibraryStatus}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,9"/><TextBlock Text="TRANSCRIPTION" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock Text="{Binding TranscriptionStatusMessage}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border><Expander Header="Technical activity" Foreground="{StaticResource MutedBrush}"><StackPanel><ItemsControl ItemsSource="{Binding StatusLogEntries}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding TimeLabel}" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" FontSize="9" TextWrapping="Wrap"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="Clear activity" Command="{Binding ClearStatusLogCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></Expander></StackPanel></ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#101722" BorderBrush="#243042" BorderThickness="0,1,0,0"><Grid Margin="28,0"><TextBlock Text="Local-first capture · transcription · speaker analysis" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/><TextBlock Text="v0.4.2" Foreground="{StaticResource AccentBrush}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
        <Grid x:Name="RecordingsWorkspace" Grid.Row="1" Margin="28,24,28,18" Visibility="Collapsed">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><StackPanel><TextBlock Text="RECORDINGS" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Your meeting library" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><Button Content="Refresh" Command="{Binding RefreshMeetingLibraryCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="10"><DataGrid ItemsSource="{Binding MeetingSessions}" SelectedItem="{Binding SelectedMeetingSession}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#151B25" Foreground="#F5F7FA" BorderThickness="0" RowBackground="#151B25" AlternatingRowBackground="#1D2633" HorizontalGridLinesBrush="#2B3747" SelectionUnit="FullRow"><DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#1D2633"/><Setter Property="Foreground" Value="#F5F7FA"/><Setter Property="BorderBrush" Value="#3B4B60"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGrid.ColumnHeaderStyle><DataGrid.Columns><DataGridTextColumn Header="Started" Binding="{Binding StartedLabel}" Width="155"/><DataGridTextColumn Header="Duration" Binding="{Binding DurationLabel}" Width="90"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/><DataGridTextColumn Header="Sources" Binding="{Binding SourceSummary}" Width="*" MinWidth="180"/><DataGridTextColumn Header="Transcript" Binding="{Binding TranscriptStatus}" Width="130"/></DataGrid.Columns></DataGrid></Border>
                <Border Grid.Row="4" Background="#192330" CornerRadius="10" Padding="13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="185"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="POST-MEETING PROCESSING" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock Text="{Binding TranscriptionStatusMessage}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding TranscriptionActivityDetail}" Foreground="{StaticResource AccentBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/><ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding TranscriptionProgress, Mode=OneWay}" IsIndeterminate="{Binding IsTranscriptionIndeterminate, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" Background="#1A3A35" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Model for next job" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding InstalledSpeechModels}" SelectedItem="{Binding SelectedSpeechModel}"/><Button Content="Cancel processing" Command="{Binding CancelTranscriptionCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,7,0,0"/></StackPanel></Grid></Border>
                <Grid Grid.Row="6"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding MeetingLibraryStatus}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding SelectedMeetingSession.Diagnostic}" Foreground="#E5B567" TextWrapping="Wrap" FontSize="10" Margin="0,3,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Delete" Click="OnDeleteSelectedRecording" IsEnabled="{Binding CanDeleteSelectedMeeting}" Background="#3A2327" BorderBrush="#8A3D45" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><ComboBox Width="190" ItemsSource="{Binding SelectedTranscriptRuns}" SelectedItem="{Binding SelectedTranscriptRun}" Margin="0,0,8,0"><ComboBox.ItemTemplate><DataTemplate><TextBlock Foreground="{StaticResource TextBrush}"><Run Text="{Binding ModelLabel, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ProcessingDurationLabel, Mode=OneWay}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Content="View transcript" Click="OnViewSelectedTranscript" IsEnabled="{Binding CanOpenSelectedTranscript}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><ComboBox Width="155" ItemsSource="{Binding InstalledSpeechModels}" SelectedItem="{Binding SelectedSpeechModel}" Margin="0,0,8,0"/><Button Content="Transcribe / retry" Command="{Binding TranscribeSelectedCommand}" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel></Grid>
            </Grid>
        </Grid>
        <Grid x:Name="TranscriptWorkspace" Grid.Row="1" Margin="28,24,28,18" Visibility="Collapsed">
            <Border x:Name="EmptyTranscriptState" Style="{StaticResource CardStyle}"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480"><TextBlock Text="NO TRANSCRIPT YET" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Nothing to review" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="Record and transcribe a meeting, or choose a transcript from the Recordings tab." Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
            <Grid x:Name="TranscriptContent" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><StackPanel><TextBlock Text="LATEST TRANSCRIPT" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Meeting transcript" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom"><StackPanel Orientation="Horizontal"><TextBox Width="220" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" ToolTip="Search transcript text or speaker"/><ComboBox Width="175" Margin="8,0,0,0" ItemsSource="{Binding SpeakerOptions}" SelectedItem="{Binding SelectedSpeaker}" DisplayMemberPath="Label"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0"><TextBlock Text="{Binding FilterResultSummary}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,16,0" VerticalAlignment="Center"/><CheckBox Content="Microphone" IsChecked="{Binding ShowMicrophone}" Foreground="{StaticResource TextBrush}" Margin="0,0,14,0"/><CheckBox Content="System audio" IsChecked="{Binding ShowSystemAudio}" Foreground="{StaticResource TextBrush}"/></StackPanel></StackPanel></Grid>
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="10"><ListBox ItemsSource="{Binding Segments}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="IsHitTestVisible" Value="False"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource RaisedBrush}" CornerRadius="9" Padding="12" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="145"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Timestamp}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas"/><TextBlock Grid.Column="1" Text="{Binding SpeakerLabel}" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding SourceLabel}" Foreground="{StaticResource MutedBrush}"/><TextBlock Grid.Column="3" Text="{Binding Text}" TextWrapping="Wrap"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
                <Grid Grid.Row="4"><TextBlock Text="{Binding SourcePath}" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Manage speakers" Click="OnManageEmbeddedSpeakers" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Export Markdown" Click="OnExportEmbeddedMarkdown" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/><Button Content="Export JSON" Click="OnExportEmbeddedJson" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel></Grid>
            </Grid>
        </Grid>
        <Grid x:Name="StorageWorkspace" Grid.Row="1" Margin="28,24,28,18" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="STORAGE CENTER" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Library capacity and evidence" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="StorageRootText" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button Content="Refresh inventory" Click="OnRefreshStorage" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><UniformGrid Grid.Row="2" Columns="4"><Border Style="{StaticResource SourceCardStyle}" Margin="0,0,6,0"><StackPanel><TextBlock Text="FREE SPACE" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="StorageFreeText" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="StorageCapacityText" Foreground="{StaticResource MutedBrush}" FontSize="9" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource SourceCardStyle}" Margin="6,0"><StackPanel><TextBlock Text="CAPTURE MASTERS" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="StorageCaptureText" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border><Border Style="{StaticResource SourceCardStyle}" Margin="6,0"><StackPanel><TextBlock Text="TRANSCRIPTS" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="StorageTranscriptText" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border><Border Style="{StaticResource SourceCardStyle}" Margin="6,0,0,0"><StackPanel><TextBlock Text="PROCESSING DATA" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="StorageProcessingText" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border></UniformGrid><Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="10"><DataGrid x:Name="StorageSessionsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#151B25" Foreground="#F5F7FA" BorderThickness="0" RowBackground="#151B25" AlternatingRowBackground="#1D2633" HorizontalGridLinesBrush="#2B3747"><DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#1D2633"/><Setter Property="Foreground" Value="#F5F7FA"/><Setter Property="BorderBrush" Value="#3B4B60"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGrid.ColumnHeaderStyle><DataGrid.Columns><DataGridTextColumn Header="Session" Binding="{Binding SessionName}" Width="*"/><DataGridTextColumn Header="Modified" Binding="{Binding ModifiedLabel}" Width="150"/><DataGridTextColumn Header="Capture" Binding="{Binding CaptureLabel}" Width="100"/><DataGridTextColumn Header="Transcripts" Binding="{Binding TranscriptLabel}" Width="100"/><DataGridTextColumn Header="Processing" Binding="{Binding ProcessingLabel}" Width="100"/><DataGridTextColumn Header="Total" Binding="{Binding TotalLabel}" Width="100"/></DataGrid.Columns></DataGrid></Border></Grid>
        <Button x:Name="StorageCleanupButton" Grid.Row="1" Content="Preview cleanup" Click="OnPreviewStorageCleanup" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,183,0" Visibility="Collapsed"/>
    </Grid>
</Window>

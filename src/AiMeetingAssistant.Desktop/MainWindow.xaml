<Window x:Class="AiMeetingAssistant.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Meeting Assistant" Width="1180" Height="760" MinWidth="920" MinHeight="620"
        Background="{StaticResource CanvasBrush}" WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="26"/><RowDefinition Height="*"/>
            <RowDefinition Height="20"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="AI MEETING ASSISTANT" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StateLabel}" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,0"/>
                <TextBlock Text="Capture, transcribe and turn conversations into clear outcomes." Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,8,0,0"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#18352E" CornerRadius="12" Padding="14,8">
                <TextBlock Text="SPRINT 1.4.2 · DUAL AUDIO CAPTURE" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/>
            </Border>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="0.75*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="New recording" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SourceSummary}" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/>
                        </StackPanel>
                        <Button Content="Refresh devices" Command="{Binding RefreshSourcesCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <Button Width="126" Height="126" Command="{Binding ToggleRecordingCommand}" ToolTip="Start or stop microphone and system audio recording" HorizontalAlignment="Center" BorderThickness="0" Background="Transparent">
                            <Grid>
                                <Ellipse Fill="#3A2327"/>
                                <Ellipse Width="72" Height="72" Fill="{StaticResource RecordBrush}"/>
                                <Ellipse Width="26" Height="26" Fill="White" Opacity="0.9">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding IsRecording}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Rectangle Width="24" Height="24" RadiusX="4" RadiusY="4" Fill="White" Opacity="0.9">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding IsRecording}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                            </Grid>
                        </Button>
                        <TextBlock Text="{Binding RecordingButtonLabel}" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0"/>
                        <TextBlock Text="{Binding RecordingElapsedLabel}" HorizontalAlignment="Center" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="SYSTEM AUDIO" Foreground="{StaticResource MutedBrush}" FontSize="10"/><ProgressBar Height="7" Margin="0,5,0,0" Maximum="100" Value="{Binding SystemAudioLevel, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" Background="#1A3A35"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="MICROPHONE" Foreground="{StaticResource MutedBrush}" FontSize="10"/><ProgressBar Height="7" Margin="0,5,0,0" Maximum="100" Value="{Binding MicrophoneLevel, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" Background="#1A3A35"/></StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding ErrorMessage}" HorizontalAlignment="Center" Foreground="{StaticResource RecordBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <UniformGrid Grid.Row="2" Columns="3">
                        <Border Background="{StaticResource RaisedBrush}" CornerRadius="10" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="SCREEN" Foreground="{StaticResource MutedBrush}" FontSize="11"/><ComboBox ItemsSource="{Binding ScreenSources}" SelectedItem="{Binding SelectedScreen}" IsEnabled="{Binding CanChangeSources}" Margin="0,8,0,0"/></StackPanel></Border>
                        <Border Background="{StaticResource RaisedBrush}" CornerRadius="10" Padding="14" Margin="4,0"><StackPanel><TextBlock Text="SYSTEM / TEAMS AUDIO" Foreground="{StaticResource MutedBrush}" FontSize="11"/><ComboBox ItemsSource="{Binding SystemAudioSources}" SelectedItem="{Binding SelectedSystemAudio}" IsEnabled="{Binding CanChangeSources}" Margin="0,8,0,0"/></StackPanel></Border>
                        <Border Background="{StaticResource RaisedBrush}" CornerRadius="10" Padding="14" Margin="8,0,0,0"><StackPanel><TextBlock Text="MICROPHONE" Foreground="{StaticResource MutedBrush}" FontSize="11"/><ComboBox ItemsSource="{Binding MicrophoneSources}" SelectedItem="{Binding SelectedMicrophone}" IsEnabled="{Binding CanChangeSources}" Margin="0,8,0,0"/></StackPanel></Border>
                    </UniformGrid>
                </Grid>
            </Border>
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Processing pipeline" FontSize="18" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding PipelineSteps}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="{Binding Name}"/><TextBlock Grid.Column="2" Text="{Binding Phase}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                </Grid>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}"><StackPanel>
                    <TextBlock Text="Privacy first" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Recordings and transcripts remain local by default. External AI providers will require explicit configuration and consent." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,0"/>
                </StackPanel></Border>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="4"><TextBlock Text="Separate microphone + system audio WAV files in artifacts/captures/" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock Text="Sprint 1.4.2 · Dual capture active" Foreground="{StaticResource AccentBrush}" FontSize="12" HorizontalAlignment="Right"/></Grid>
    </Grid>
</Window>

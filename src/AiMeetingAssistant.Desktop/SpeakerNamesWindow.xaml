<Window x:Class="AiMeetingAssistant.Desktop.SpeakerNamesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage speakers" Width="560" Height="460" MinWidth="480" MinHeight="340"
        Background="{StaticResource CanvasBrush}" WindowStartupLocation="CenterOwner">
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="SPEAKER NAMES" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/>
            <TextBlock Text="Name detected speakers" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0"/>
            <TextBlock Text="Names apply only to this meeting. Leave a field blank to show the technical speaker ID." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
        </StackPanel>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12">
            <ListBox ItemsSource="{Binding Entries}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate><Grid Margin="4,6"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SpeakerId}" VerticalAlignment="Center" FontFamily="Consolas" Foreground="{StaticResource MutedBrush}"/><TextBox Grid.Column="1" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Padding="8" MaxLength="100"/></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="OnCancel" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
            <Button Content="Save names" Click="OnSave" Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>

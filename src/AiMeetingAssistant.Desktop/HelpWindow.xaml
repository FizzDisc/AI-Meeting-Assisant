<Window x:Class="AiMeetingAssistant.Desktop.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="How it works · AI Meeting Assistant"
        Icon="Assets/assistant-avatar.png"
        Width="920" Height="700" MinWidth="760" MinHeight="560"
        Background="{StaticResource CanvasBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="112" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <Border Background="#101722" BorderBrush="#243042" BorderThickness="0,0,0,1">
            <Grid Margin="30,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="64" Height="64" CornerRadius="32" ClipToBounds="True"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="2">
                    <Image Source="Assets/assistant-avatar.png" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="HOW IT WORKS" Foreground="{StaticResource AccentBrush}"
                               FontSize="11" FontWeight="Bold" />
                    <TextBlock Text="Your meeting workspace, in five minutes"
                               FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0" />
                    <TextBlock Text="Open this guide whenever you need it — it never starts automatically."
                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="30,20,22,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="TopicList" SelectionChanged="OnTopicChanged"
                     Background="Transparent" BorderThickness="0">
                <ListBox.Resources>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Setter Property="Padding" Value="14,11" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="TopicBorder" Background="Transparent"
                                            BorderBrush="Transparent" BorderThickness="1" CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TopicBorder" Property="Background" Value="#1D2633" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TopicBorder" Property="Background" Value="#20352F" />
                                            <Setter TargetName="TopicBorder" Property="BorderBrush" Value="#315D52" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.Resources>
                <ListBoxItem Content="Capture" Tag="Capture" />
                <ListBoxItem Content="Recordings" Tag="Recordings" />
                <ListBoxItem Content="Transcript" Tag="Transcript" />
                <ListBoxItem Content="Storage" Tag="Storage" />
                <ListBoxItem Content="Settings" Tag="Settings" />
            </ListBox>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="26">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="TopicEyebrow" Foreground="{StaticResource AccentBrush}"
                                   FontSize="11" FontWeight="Bold" />
                        <TextBlock x:Name="TopicTitle" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0" />
                        <TextBlock x:Name="TopicSummary" Foreground="{StaticResource MutedBrush}"
                                   FontSize="13" TextWrapping="Wrap" Margin="0,8,0,20" />
                        <ItemsControl x:Name="StepList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="20" Height="20" CornerRadius="10" Background="#23453F"
                                                HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="✓" Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="11" FontWeight="Bold" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextBrush}" FontSize="13" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Background="#18212D" BorderBrush="#2E4053" BorderThickness="1"
                                CornerRadius="8" Padding="14" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="TIP" Foreground="{StaticResource AccentBrush}"
                                           FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="TopicTip" Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#101722" BorderBrush="#243042" BorderThickness="0,1,0,0">
            <Grid Margin="30,0">
                <TextBlock Text="Nothing here changes your settings or starts a recording."
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="11" />
                <Button Content="Close guide" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>

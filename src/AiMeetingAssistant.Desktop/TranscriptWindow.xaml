<Window x:Class="AiMeetingAssistant.Desktop.TranscriptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meeting transcript" Width="940" Height="700" MinWidth="720" MinHeight="500"
        Background="{StaticResource CanvasBrush}" WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="TRANSCRIPT" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Text="Meeting transcript" FontSize="27" FontWeight="SemiBold" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
                <CheckBox Content="Microphone" IsChecked="{Binding ShowMicrophone}" Foreground="{StaticResource TextBrush}" Margin="0,0,18,0"/>
                <CheckBox Content="System audio" IsChecked="{Binding ShowSystemAudio}" Foreground="{StaticResource TextBrush}"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12">
            <ListBox ItemsSource="{Binding Segments}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/><Setter Property="IsHitTestVisible" Value="False"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource RaisedBrush}" CornerRadius="9" Padding="14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="145"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Timestamp}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas"/>
                                <TextBlock Grid.Column="1" Text="{Binding SpeakerLabel}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="{Binding SourceLabel}" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Grid.Column="3" Text="{Binding Text}" TextWrapping="Wrap" LineHeight="21"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <Grid Grid.Row="4">
            <TextBlock Text="{Binding SourcePath}" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Manage speakers" Click="OnManageSpeakers" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                <Button Content="Export Markdown" Click="OnExportMarkdown" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                <Button Content="Export JSON" Click="OnExportJson" Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

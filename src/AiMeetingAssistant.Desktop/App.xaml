<Application x:Class="AiMeetingAssistant.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#0C1017" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#151B25" />
        <SolidColorBrush x:Key="RaisedBrush" Color="#1D2633" />
        <SolidColorBrush x:Key="TextBrush" Color="#F5F7FA" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9AA8B8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#6DD6B7" />
        <SolidColorBrush x:Key="RecordBrush" Color="#F25F5C" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="22" />
        </Style>
    </Application.Resources>
</Application>

